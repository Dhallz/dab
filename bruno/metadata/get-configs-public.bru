meta {
  name: Get Provider Configs (Public)
  type: http
  seq: 2
}

docs {
  Lists essential configuration for active providers (e.g., base URLs for deep links).
  This endpoint is public and does not require authentication.
}

get {
  url: {{baseUrl}}/metadata/configs
  body: none
  auth: none
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Returns configs array", function() {
    expect(res.body.data).to.be.an("array");
  });
}
