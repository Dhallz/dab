meta {
  name: System Status
  type: http
  seq: 1
}

docs {
  Returns the current initialization state of the DAB system.
  Used by the client to determine if the first-run configuration wizard should be displayed.
}

get {
  url: {{baseUrl}}/metadata/status
  body: none
  auth: none
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Returns isSystemConfigured", function() {
    expect(res.body.data).to.have.property("isSystemConfigured");
  });
}
