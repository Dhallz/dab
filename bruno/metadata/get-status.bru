meta {
  name: System Status
  type: http
  seq: 1
}

docs {
  Returns the current initialization state of the DAB system.
  Used by the client to determine if the first-run configuration wizard should be displayed.

  `deploymentMode` is `managed` (Admin-owned tokens) or `individual` (Settings PATs).
  Legacy stored values `organization` and `personal` are normalized on read.

  Daily-report deadline (org-global): `dailyReportLockOffsetDays` (0–7, default 1) and
  `dailyReportLockTime` (`HH:mm`, default `00:00`). A report for date D locks at
  (D + offset) at that time in `systemTimezone`. Default is same-day editing (next-day midnight).
}

get {
  url: {{baseUrl}}/metadata/status
  body: none
  auth: none
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Returns isSystemConfigured", function() {
    expect(res.body.data).to.have.property("isSystemConfigured");
    expect(res.body.data).to.have.property("systemTimezone");
    expect(res.body.data).to.have.property("deploymentMode");
    expect(["managed", "individual"]).to.include(res.body.data.deploymentMode);
    expect(res.body.data).to.have.property("dailyReportLockOffsetDays");
    expect(res.body.data).to.have.property("dailyReportLockTime");
  });
}
