meta {
  name: 24 Link Jira Identity
  type: http
  seq: 24
}

docs {
  Links a DAB user to a Jira Cloud account id.

  Requires `targetUserId` and `jiraExternalId`.
}

post {
  url: {{baseUrl}}/admin/identities/link
  body: json
  auth: inherit
}

body:json {
  {
    "userId": "{{targetUserId}}",
    "providerId": "jira",
    "externalId": "{{jiraExternalId}}",
    "externalUsername": "{{jiraExternalId}}"
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
