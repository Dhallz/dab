meta {
  name: 26 Link Phorge Identity
  type: http
  seq: 26
}

docs {
  Links a DAB user to a Phorge user PHID.

  Requires `targetUserId` and `phorgeExternalId` (e.g. `PHID-USER-…`).
}

post {
  url: {{baseUrl}}/admin/identities/link
  body: json
  auth: inherit
}

body:json {
  {
    "userId": "{{targetUserId}}",
    "providerId": "phorge",
    "externalId": "{{phorgeExternalId}}",
    "externalUsername": "{{phorgeExternalId}}"
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
