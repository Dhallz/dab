meta {
  name: 25 Link Linear Identity
  type: http
  seq: 25
}

docs {
  Links a DAB user to a Linear user id.

  Requires `targetUserId` and `linearExternalId`.
}

post {
  url: {{baseUrl}}/admin/identities/link
  body: json
  auth: inherit
}

body:json {
  {
    "userId": "{{targetUserId}}",
    "providerId": "linear",
    "externalId": "{{linearExternalId}}",
    "externalUsername": "{{linearExternalId}}"
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
