meta {
  name: 1. Login
  type: http
  seq: 1
}

docs {
  Authenticates and captures `accessToken` for the GitHub polling flow.
  Requires `adminEmail` and `adminPassword` in the active environment.
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body.accessToken) {
    bru.setEnvVar("accessToken", res.body.accessToken);
    bru.setVar("accessToken", res.body.accessToken);
    console.log("GitHub polling flow: accessToken captured");
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Returns accessToken", function() {
    expect(res.body.accessToken).to.be.a("string");
  });
}
