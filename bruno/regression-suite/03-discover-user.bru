meta {
  name: 3. Discover User
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/users
  body: none
  auth: inherit
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.length > 0) {
    const user = res.body.data[0];
    bru.setEnvVar("targetUserId", user.id);
    console.log("Automatically selected targetUserId: " + user.id + " (" + user.name + ")");
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Users found", function() {
    expect(res.body.data.length).to.be.greaterThan(0);
  });
}
