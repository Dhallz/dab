meta {
  name: Save My Credential
  type: http
  seq: 5
}

docs {
  Saves a personal PAT (or Slack/Discord bot token) for the authenticated user.
  Runs whoami, links `UserIdentity` as `linked`, and may seed a watch list on `provider_configs`.
  Never send real tokens in committed examples — use environment variables.
}

put {
  url: {{baseUrl}}/users/me/credentials/github
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "settings": {
      "api.token": "{{githubPat}}"
    }
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Does not echo the secret", function() {
    expect(res.body.data.apiToken).to.equal(undefined);
    expect(res.body.data.settings).to.equal(undefined);
  });
}
