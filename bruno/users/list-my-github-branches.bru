meta {
  name: List My GitHub Branches
  type: http
  seq: 16
}

docs {
  Lists unique branch names on the caller's selected GitHub inbox repos
  (or `?repos=owner/repo,owner/other`). Used by Settings to populate the
  searchable branch dropdown. Empty `available` when no repos are selected.
  `truncated` is true when the catalog hit its name cap. Requires a connected
  GitHub credential. Never returns tokens.
}

get {
  url: {{baseUrl}}/users/me/credentials/github/branches?repos=acme/app
  body: none
  auth: inherit
}

tests {
  test("Status 200 or 400", function() {
    expect([200, 400]).to.include(res.status);
  });
  test("Does not return tokens", function() {
    const body = JSON.stringify(res.body || {});
    expect(body).to.not.include("access_token");
    expect(body).to.not.include("apiToken");
  });
}
