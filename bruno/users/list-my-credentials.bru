meta {
  name: List My Credentials
  type: http
  seq: 4
}

docs {
  Returns masked credential status for the authenticated user. Secrets are never included.

  ### Database Mapping
  | API Field | DB Table | DB Column | Role |
  | :--- | :--- | :--- | :--- |
  | `providerId` | `user_provider_credentials` | `provider_id` | Provider slug |
  | `status` | `user_provider_credentials` | `status` | `connected` / `failed` |
  | `hasSecret` | derived | — | True when a user row or shared bot exists |
  | `externalUsername` | `user_identities` | `external_username` | Linked login from whoami |
}

get {
  url: {{baseUrl}}/users/me/credentials
  body: none
  auth: inherit
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Returns credential list", function() {
    expect(res.body.data).to.be.an("array");
  });
}
