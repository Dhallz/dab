meta {
  name: List My Linear Teams
  type: http
  seq: 11
}

docs {
  Lists Linear teams visible to the authenticated user's OAuth token,
  plus the instance watch list (`provider_configs.settings.teamKeys`).
  Requires a connected Linear credential. Secrets are never returned.
}

get {
  url: {{baseUrl}}/users/me/credentials/linear/projects
  body: none
  auth: inherit
}

tests {
  test("Status 200 or 400", function() {
    expect([200, 400]).to.include(res.status);
  });
  test("Does not return tokens", function() {
    const body = JSON.stringify(res.body || {});
    expect(body).to.not.include("access_token");
    expect(body).to.not.include("apiKey");
  });
}
