meta {
  name: Delete My Credential
  type: http
  seq: 7
}

docs {
  Removes the authenticated user's credential for a provider.
  For Slack/Discord, clears the org bot token when no other user rows remain.
}

delete {
  url: {{baseUrl}}/users/me/credentials/github
  body: none
  auth: inherit
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
