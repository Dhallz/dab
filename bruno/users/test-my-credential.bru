meta {
  name: Test My Credential
  type: http
  seq: 6
}

docs {
  Verifies stored or posted credentials for the authenticated user without requiring a save.
}

post {
  url: {{baseUrl}}/users/me/credentials/github/test
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "settings": {
      "api.token": "{{githubPat}}"
    }
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
