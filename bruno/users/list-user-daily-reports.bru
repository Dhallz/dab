meta {
  name: List User Daily Reports
  type: http
  seq: 22
}

docs {
  Lists org-calendar dates (`YYYY-MM-DD`) with a saved daily report for
  `{id}`, newest first. Standard users receive 403 unless `id` is self.
  Managers and admins may list teammates. Empty lists are `200` with
  `data: []`. Set `targetUserId` from Get Users.
}

get {
  url: {{baseUrl}}/users/{{targetUserId}}/day-reports
  body: none
  auth: inherit
}

tests {
  test("Status 200 or 403", function() {
    expect([200, 403]).to.include(res.status);
  });
  test("Returns a date list envelope when successful", function() {
    if (res.status !== 200) return;
    expect(res.body).to.have.property("data");
    expect(res.body.data).to.be.an("array");
  });
}
