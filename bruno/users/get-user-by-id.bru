meta {
  name: Get User By Id
  type: http
  seq: 2
}

docs {
  Retrieves the profile details for a specific user.
  Requires a valid `targetUserId` variable.
  
  ### Database Mapping
  | API Field | DB Table | DB Column | Role |
  | :--- | :--- | :--- | :--- |
  | `id` | `users` | `id` | Lookup identifier |
  | `name` | `users` | `name` | Value from user record |
  | `role` | `users` | `role` | User role |
}

get {
  url: {{baseUrl}}/users/{{targetUserId}}
  body: none
  auth: inherit
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
