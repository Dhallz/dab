meta {
  name: Delete Group
  type: http
  seq: 3
}

docs {
  Permanently deletes an activity group by ID.
  
  **Path parameters**:
  - `targetGroupId`: UUID of the group to delete.
}

delete {
  url: {{baseUrl}}/groups/{{targetGroupId}}
  body: none
  auth: inherit
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
