meta {
  name: Get Groups
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/groups
  body: none
  auth: inherit
}

script:post-response {
  if (res.status === 200 && res.body.data && res.body.data.length > 0) {
    const firstGroup = res.body.data[0];
    bru.setEnvVar("targetGroupId", firstGroup.id);
    bru.setVar("targetGroupId", firstGroup.id);
    console.log("Automatically populated targetGroupId with: " + firstGroup.id);
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
