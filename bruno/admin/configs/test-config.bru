meta {
  name: Test Provider Config
  type: http
  seq: 3
}

docs {
  Administrative endpoint to test connectivity for a provider configuration without saving it.
  
  **Request Body**: Identical to `Save Provider Config`.
  
  Returns a status message indicating whether the connection was successful.
  
  ### Database Mapping
  | Action | DB Table | Role |
  | :--- | :--- | :--- |
  | N/A | N/A | Stateless (No DB mutations) |
}

post {
  url: {{baseUrl}}/admin/configs/test
  body: json
  auth: inherit
}

body:json {
  {
    "id": "{{targetProviderId}}",
    "name": "{{targetProviderId}}",
    "baseUrl": "{{targetProviderUrl}}",
    "isActive": true,
    "settings": {
      "apiToken": "{{targetProviderToken}}"
    }
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("Connectivity report is returned", function() {
    expect(res.body.data).to.be.an("object");
    expect(res.body.data).to.have.property("success");
    expect(res.body.data).to.have.property("message");
  });
}
