# Copy to local-secrets.bru and fill in real credentials.
# local-secrets.bru is gitignored.

vars {
  baseUrl: http://localhost:9080

  # Auth (bootstrap admin or existing admin)
  adminEmail: admin@example.com
  adminPassword: changeme

  # System settings (02-save-system-settings)
  publicApiUrl: http://localhost:9080
  systemTimezone: America/New_York
  allowedDomainEnabled: false
  allowedDomain: example.com

  # Webhook URLs (auto-set by 02 / 04 from publicApiUrl — paste into provider consoles)
  githubWebhookUrl:
  slackWebhookUrl:
  gitlabWebhookUrl:
  bitbucketWebhookUrl:
  jiraWebhookUrl:
  linearWebhookUrl:
  phorgeWebhookUrl:
  figmaWebhookUrl:

  # Identity linking (optional 20–28 steps)
  targetUserId:
  githubExternalUsername: your-github-login
  slackExternalId:
  gitlabExternalId:
  bitbucketExternalId:
  jiraExternalId:
  linearExternalId:
  phorgeExternalId:
  discordExternalId:
  figmaExternalId:

  # GitHub (10-save-github)
  githubApiToken:
  githubWebhookSecret:
  githubApiBaseUrl: https://api.github.com
  githubOwner:
  githubRepo:
  githubRepos:
  githubBranch:

  # Slack (11-save-slack)
  slackBotToken:
  slackSigningSecret:
  slackWorkspaceId:
  slackApiBaseUrl: https://slack.com/api
  slackChannels:

  # GitLab (12-save-gitlab)
  gitlabApiToken:
  gitlabInstanceUrl: https://gitlab.com
  gitlabWebhookSecret:
  gitlabProjects:
  gitlabBranch:

  # Bitbucket (13-save-bitbucket)
  bitbucketUsername:
  bitbucketApiToken:
  bitbucketWorkspace:
  bitbucketWebhookSecret:
  bitbucketRepos:

  # Jira (14-save-jira)
  jiraApiToken:
  jiraEmail:
  jiraInstanceUrl: https://your-site.atlassian.net
  jiraWebhookSecret:
  jiraProjectKeys:

  # Linear (15-save-linear)
  linearApiKey:
  linearWebhookSecret:

  # Phorge (16-save-phorge)
  phorgeBaseUrl: https://phorge.example.com
  phorgeApiToken:
  phorgeWebhookHmacKey:
  phorgeProject:

  # Discord (17-save-discord)
  discordBotToken:
  discordGuildId:
  discordChannels:

  # Figma (18-save-figma + bruno/figma create-webhook-*)
  figmaApiToken:
  figmaWebhookSecret:
  figmaFileKeys:
  figmaTeamIds:
  figmaTeamId:
  figmaWebhookWriteToken:
}

vars:secret [
  adminPassword,
  githubApiToken,
  githubWebhookSecret,
  slackBotToken,
  slackSigningSecret,
  gitlabApiToken,
  gitlabWebhookSecret,
  bitbucketApiToken,
  bitbucketWebhookSecret,
  jiraApiToken,
  jiraWebhookSecret,
  linearApiKey,
  linearWebhookSecret,
  phorgeApiToken,
  phorgeWebhookHmacKey,
  discordBotToken,
  figmaApiToken,
  figmaWebhookSecret,
  figmaWebhookWriteToken
]
