meta {
  name: Linear Webhook Comment
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/integrations/linear/webhook
  body: json
  auth: none
}

headers {
  linear-signature: {{linearSignature}}
  linear-delivery: {{linearDelivery}}
  linear-event: Comment
}

body:json {
  {
    "action": "create",
    "type": "Comment",
    "createdAt": "2026-03-01T15:35:00.000Z",
    "url": "https://linear.app/acme/issue/DAB-42#comment-uuid-example",
    "data": {
      "id": "comment-uuid-example",
      "body": "Can you take a look at this?",
      "createdAt": "2026-03-01T15:35:00.000Z",
      "userId": "user-uuid-example",
      "user": {
        "id": "user-uuid-example",
        "name": "Dev User"
      },
      "issue": {
        "id": "issue-uuid-example",
        "identifier": "DAB-42",
        "title": "Example issue from webhook",
        "url": "https://linear.app/acme/issue/DAB-42",
        "updatedAt": "2026-03-01T15:35:00.000Z",
        "state": {
          "name": "In Progress"
        },
        "team": {
          "key": "DAB"
        },
        "assignee": {
          "id": "user-uuid-example",
          "name": "Dev User"
        }
      }
    }
  }
}

vars:pre-request {
  linearSignature: 
}

script:pre-request {
  const CryptoJS = require("crypto-js");
  
  const signingSecret =
    bru.getEnvVar("linearWebhookSecret") ||
    bru.getEnvVar("LINEAR_WEBHOOK_SECRET") ||
    bru.getVar("linearWebhookSecret") ||
    bru.getVar("LINEAR_WEBHOOK_SECRET");
  
  if (!signingSecret) {
    throw new Error(
      "Missing Linear webhook secret. Set linearWebhookSecret or LINEAR_WEBHOOK_SECRET.",
    );
  }
  
  const rawBody = req.getBody({ raw: true });
  const digest = CryptoJS.HmacSHA256(rawBody, signingSecret).toString(
    CryptoJS.enc.Hex,
  );
  const delivery = `del-${Date.now()}`;
  
  req.setHeader("linear-signature", digest);
  req.setHeader("linear-delivery", delivery);
  req.setHeader("Content-Type", "application/json");
  
  bru.setVar("linearSignature", digest);
  bru.setVar("linearDelivery", delivery);
}

tests {
  test("Acknowledged or unauthorized", function() {
    expect(res.status).to.be.oneOf([200, 401, 500]);
  });
}

docs {
  Simulates a Linear `Comment` webhook to `POST /integrations/linear/webhook`.

  Same HMAC signing as the Issue webhook. The comment is ingested as its own
  live activity (Dashboard notify) grouped in Explorer by `DAB-42`.
}
