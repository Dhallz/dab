meta {
  name: Create Mock Activity
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/mock/activity
  body: json
  auth: none
}

body:json {
  {
    "userId": "{{targetUserId}}",
    "provider": "Mock",
    "type": "generic",
    "title": "Test Activity",
    "content": "This is a test activity created via Bruno",
    "url": "https://example.com"
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Activity logged", function() {
    expect(res.body.status).to.equal("Activity logged and broadcasted");
  });
}
