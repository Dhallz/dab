meta {
  name: Jira Webhook
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/integrations/jira/webhook
  body: json
  auth: none
}

headers {
  X-Hub-Signature: {{jiraHubSignature}}
}

body:json {
  {
    "webhookEvent": "jira:issue_updated",
    "issue": {
      "id": "10001",
      "key": "DAB-42",
      "fields": {
        "summary": "Example issue from webhook",
        "status": {
          "name": "In Progress"
        },
        "updated": "2026-03-01T15:30:00.000+0000",
        "assignee": {
          "accountId": "5b10ac8d82e05b22cc7d4ef5",
          "displayName": "Dev User",
          "emailAddress": "dev@example.com"
        }
      }
    },
    "user": {
      "accountId": "5b10ac8d82e05b22cc7d4ef5",
      "displayName": "Dev User"
    }
  }
}

vars:pre-request {
  jiraWebhookSecret:
}

script:pre-request {
  const CryptoJS = require("crypto-js");

  const webhookSecret =
    bru.getEnvVar("jiraWebhookSecret") ||
    bru.getEnvVar("JIRA_WEBHOOK_SECRET") ||
    bru.getRequestVar("jiraWebhookSecret") ||
    bru.getRequestVar("JIRA_WEBHOOK_SECRET") ||
    bru.getCollectionVar("jiraWebhookSecret") ||
    bru.getVar("jiraWebhookSecret") ||
    bru.getVar("JIRA_WEBHOOK_SECRET");

  if (!webhookSecret) {
    throw new Error(
      "Missing Jira webhook secret. Set jiraWebhookSecret in the active " +
        "environment (local-secrets.bru), this request's Pre Request vars, or " +
        "collection vars. Must match Admin → Jira → webhookSecret and Jira " +
        "webhook Secret field.",
    );
  }

  const rawBody = req.getBody({ raw: true });
  const digest = CryptoJS.HmacSHA256(rawBody, webhookSecret).toString(
    CryptoJS.enc.Hex,
  );
  const signature = `sha256=${digest}`;

  req.setHeader("X-Hub-Signature", signature);
  req.setHeader("Content-Type", "application/json");

  bru.setVar("jiraHubSignature", signature);
  bru.setVar("jiraWebhookSecret", webhookSecret);
}

tests {
  test("Acknowledged or unauthorized", function() {
    expect(res.status).to.be.oneOf([200, 401, 500]);
  });
}

docs {
  Simulates a Jira Cloud admin webhook delivery to `POST /integrations/jira/webhook`.

  Jira signs the raw JSON body with HMAC-SHA256 and sends
  `X-Hub-Signature: sha256=<hex>` when a Secret is configured on the webhook
  (Atlassian "Secure admin webhooks"). The secret itself is **not** in the URL.

  Set the same secret in:
  - Admin → Jira → `webhookSecret`
  - Jira → System → Webhooks → **Secret** field
  - Bruno env / Pre Request var `jiraWebhookSecret`

  Supported events: `jira:issue_created`, `jira:issue_updated`.

  Webhook URL in Jira (no secret query param):
  `https://<public-api>/integrations/jira/webhook`
}
