meta {
  name: Figma Webhook Comment
  type: http
  seq: 18
}

docs {
  `FILE_COMMENT` — Directed when you are in `mentions[]`; Following when you
  Follow that `file_key`. Auth is JSON `passcode` vs Live `webhookSecret`.
}

post {
  url: {{baseUrl}}/integrations/figma/webhook
  body: json
  auth: none
}

body:json {
  {
    "event_type": "FILE_COMMENT",
    "file_key": "Abc123File",
    "file_name": "Onboarding",
    "timestamp": "2026-08-01T12:00:00Z",
    "passcode": "{{figmaWebhookSecret}}",
    "triggered_by": {
      "id": "fig-alice",
      "handle": "Alice"
    },
    "comment": [
      {
        "id": "c-1",
        "message": "Please take a look",
        "created_at": "2026-08-01T12:00:00Z",
        "mentions": [
          {
            "id": "fig-bob"
          }
        ]
      }
    ]
  }
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
}
