meta {
  name: Get Live Activities
  type: http
  seq: 4
}

docs {
  Retrieves Redis-backed live activities for Dashboard realtime hydration.
  This endpoint is dedicated to live data and does not query Postgres directly.

  **Query Parameters**:
  - `limit` (optional, 1..100): Max number of events to read. Default: 50.
  - `scope` (optional): `user` (default) or `global`.

  ### Live Data Mapping
  | API Field | Redis Key | Role |
  | :--- | :--- | :--- |
  | `data[]` | `activities:user:{id}` | User-scoped rolling feed |
  | `data[]` | `activities:global` | Global rolling feed |
  | `meta.syncToken` | `dab:version` | Vegas version clock |
}

get {
  url: {{baseUrl}}/activities/live
  body: none
  auth: inherit
}

params:query {
  limit: 50
  scope: user
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Returns live activity array", function() {
    expect(res.body).to.have.property("data");
    expect(res.body.data).to.be.an("array");
  });
}
